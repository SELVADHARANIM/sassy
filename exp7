include <stdio.h>
int main()
{
    int n, i;
    char lhs, op1, op2, op;
    printf("Enter number of instructions: ");
    scanf("%d", &n);
    printf("Enter Three Address Code:\n");
    for(i = 0; i < n; i++)
    {
        scanf(" %c = %c %c %c", &lhs, &op1, &op, &op2);
        printf("\n8086 Assembly Code:\n");
        printf("MOV AX, %c\n", op1);
        switch(op)
        {
            case '+':
                printf("ADD AX, %c\n", op2);
                break;
            case '-':
                printf("SUB AX, %c\n", op2);
                break;
            case '*':
                printf("MOV BX, %c\n", op2);
                printf("MUL BX\n");
                break;
            case '/':
                printf("MOV BX, %c\n", op2);
                printf("XOR DX, DX\n");
                printf("DIV BX\n");
                break;
            default:
                printf("Invalid operator\n");
                continue;
        }
        printf("MOV %c, AX\n", lhs);
    }
    return 0;
}
