Tac.l

%{
#include "y.tab.h"
#include <string.h>
%}

%option noyywrap

%%
[a-zA-Z][a-zA-Z0-9]* {
    strcpy(yylval.str, yytext);
    return ID;
}

[0-9]+ {
    strcpy(yylval.str, yytext);
    return ID;
}

[ \t]+  ;
\n      { return '\n'; }
.       { return yytext[0]; }
%%


tac.y 

%{
#include <stdio.h>
#include <string.h>

int temp = 1;

int yylex(void);
int yyerror(char *s);
%}

%union {
    char str[20];
}

%token <str> ID
%type <str> expr

%left '+' '-'
%left '*' '/'

%%

input:
    ID '=' expr '\n'
    {
        printf("%s = %s\n", $1, $3);
    }
    ;

expr:
    ID
    {
        strcpy($$, $1);
    }
    |
    expr '+' expr
    {
        sprintf($$, "t%d", temp);
        printf("%s = %s + %s\n", $$, $1, $3);
        temp++;
    }
    |
    expr '-' expr
    {
        sprintf($$, "t%d", temp);
        printf("%s = %s - %s\n", $$, $1, $3);
        temp++;
    }
    |
    expr '*' expr
    {
        sprintf($$, "t%d", temp);
        printf("%s = %s * %s\n", $$, $1, $3);
        temp++;
    }
    |
    expr '/' expr
    {
        sprintf($$, "t%d", temp);
        printf("%s = %s / %s\n", $$, $1, $3);
        temp++;
    }
    |
    '(' expr ')'
    {
        strcpy($$, $2);
    }
    ;

%%

int main()
{
    printf("Enter an expression: ");
    yyparse();
    return 0;
}

int yyerror(char *s)
{
    printf("Invalid expression\n");
    return 0;
}

