#include <stdio.h>
int main()
{
    int a, b;
    printf("Enter two numbers: ");
    scanf("%d %d", &a, &b);
    printf("\nConstant Folding: %d\n\n", a + b);
    printf("Strength Reduction: %d + %d\n\n", a, a);
    printf("Algebraic Transformation:\n");
    printf("Addition(a+0): %d\n", a);
    printf("Multiplication(a*1): %d\n", a);
    printf("Zero Multiplication(a*0): 0\n");
    return 0;
}
