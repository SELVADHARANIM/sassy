Optimize.l

%{
#include "y.tab.h"
#include <string.h>
%}

%option noyywrap

%%

[0-9]+ {
    strcpy(yylval.str, yytext);
    return NUMBER;
}

[a-zA-Z][a-zA-Z0-9]* {
    strcpy(yylval.str, yytext);
    return ID;
}

[ \t]+  ;

\n      { return '\n'; }

.       { return yytext[0]; }
%%

optimize.y 

%{
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int yylex(void);
int yyerror(char *s);
%}

%union {
    char str[100];

    struct {
        char code[100];
        int is_const;
        int value;
    } e;
}

%token <str> ID NUMBER
%type <e> expr

%left '+' '-'
%left '*' '/'

%%

input:
      /* empty */
    | input line
    ;

line:
      ID '=' expr '\n'
      {
          printf("Optimized: %s = %s\n", $1, $3.code);
      }
    ;

expr:
      NUMBER
      {
          strcpy($$.code, $1);
          $$.is_const = 1;
          $.value=atoi(1);
      }

    | ID
      {
          strcpy($$.code, $1);
          $$.is_const = 0;
          $$.value = 0;
      }

    | expr '+' expr
      {
          if ($1.is_const && $3.is_const) {
              $$.value = $1.value + $3.value;
              sprintf(
.code,"%d",
.value);
              $$.is_const = 1;
          }
          else if ($1.is_const && $1.value == 0) {
              $$ = $3;
          }
          else if ($3.is_const && $3.value == 0) {
              $$ = $1;
          }
          else {
              sprintf($$.code, "(%s + %s)", $1.code, $3.code);
              $$.is_const = 0;
          }
      }

    | expr '-' expr
      {
          if ($1.is_const && $3.is_const) {
              $$.value = $1.value - $3.value;
              sprintf(
.code,"%d",
.value);
              $$.is_const = 1;
          }
          else if ($3.is_const && $3.value == 0) {
              $$ = $1;
          }
          else {
              sprintf($$.code, "(%s - %s)", $1.code, $3.code);
              $$.is_const = 0;
          }
      }

    | expr '*' expr
      {
          if ($1.is_const && $3.is_const) {
              $$.value = $1.value * $3.value;
              sprintf(
.code,"%d",
.value);
              $$.is_const = 1;
          }
          else if (($1.is_const && $1.value == 0) ||
                   ($3.is_const && $3.value == 0)) {
              strcpy($$.code, "0");
              $$.is_const = 1;
              $$.value = 0;
          }
          else if ($1.is_const && $1.value == 1) {
              $$ = $3;
          }
          else if ($3.is_const && $3.value == 1) {
              $$ = $1;
          }
          else if ($1.is_const && $1.value == 2) {
              sprintf($$.code, "(%s + %s)", $3.code, $3.code);
              $$.is_const = 0;
          }
          else if ($3.is_const && $3.value == 2) {
              sprintf($$.code, "(%s + %s)", $1.code, $1.code);
              $$.is_const = 0;
          }
          else {
              sprintf($$.code, "(%s * %s)", $1.code, $3.code);
              $$.is_const = 0;
          }
      }

    | expr '/' expr
      {
          if ($1.is_const && $3.is_const && $3.value != 0) {
              $$.value = $1.value / $3.value;
              sprintf(
.code,"%d",
.value);
              $$.is_const = 1;
          }
          else if ($3.is_const && $3.value == 1) {
              $$ = $1;
          }
          else {
              sprintf($$.code, "(%s / %s)", $1.code, $3.code);
              $$.is_const = 0;
          }
      }

    | '(' expr ')'
      {
          $$ = $2;
      }
    ;

%%

int main()
{
    printf("Enter expressions (one per line):\n");
    yyparse();
    return 0;
}

int yyerror(char *s)
{
    printf("Invalid expression\n");
    return 0;
}

