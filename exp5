Type.y

%{
#include <stdio.h>
#include <string.h>

#define T_INT 1
#define T_FLOAT 2

struct symbol
{
    char name[50];
    int type;
};

struct symbol table[100];
int count = 0;

int lookup(char *name)
{
    int i;

    for(i = 0; i < count; i++)
    {
        if(strcmp(table[i].name, name) == 0)
            return i;
    }

    return -1;
}

void add(char *name, int type)
{
    strcpy(table[count].name, name);
    table[count].type = type;
    count++;
}

char *type_name(int type)
{
    if(type == T_INT)
        return "int";
    else
        return "float";
}

int yylex(void);
int yyerror(char *s);
%}

%union
{
    char name[50];
    int dtype;
}

%token INT FLOAT INT_NUM FLOAT_NUM
%token <name> ID

%type <dtype> decl_type expr

%left '+' '-'
%left '*' '/'

%%

program:
      /* empty */
    | program statement
    ;

statement:

      decl_type ID ';'
      {
          if(lookup($2) != -1)
          {
              printf("Error: Variable already declared\n");
          }
          else
          {
              add($2, $1);

              printf("%s declared as %s\n",
                     2,typename(1));
          }
      }

    |

      ID '=' expr ';'
      {
          int i = lookup($1);

          if(i == -1)
          {
              printf("Error: Undeclared variable %s\n", $1);
          }

          else if(table[i].type != $3)
          {
              printf("Type mismatch: %s is %s but expression is %s\n",
                     $1,
                     type_name(table[i].type),
                     type_name($3));
          }

          else
          {
              printf("Valid assignment to %s\n", $1);
          }
      }

    ;

decl_type:

      INT
      {
          $$ = T_INT;
      }

    |

      FLOAT
      {
          $$ = T_FLOAT;
      }

    ;

expr:

      INT_NUM
      {
          $$ = T_INT;
      }

    |

      FLOAT_NUM
      {
          $$ = T_FLOAT;
      }

    |

      ID
      {
          int i = lookup($1);

          if(i == -1)
          {
              printf("Error: Undeclared variable %s\n", $1);
              $$ = T_INT;
          }
          else
          {
              $$ = table[i].type;
          }
      }

    |

      expr '+' expr
      {
          if($1 == T_FLOAT || $3 == T_FLOAT)
              $$ = T_FLOAT;
          else
              $$ = T_INT;
      }

    |

      expr '-' expr
      {
          if($1 == T_FLOAT || $3 == T_FLOAT)
              $$ = T_FLOAT;
          else
              $$ = T_INT;
      }

    |

      expr '*' expr
      {
          if($1 == T_FLOAT || $3 == T_FLOAT)
              $$ = T_FLOAT;
          else
              $$ = T_INT;
      }

    |

      expr '/' expr
      {
          if($1 == T_FLOAT || $3 == T_FLOAT)
              $$ = T_FLOAT;
          else
              $$ = T_INT;
      }

    |

      '(' expr ')'
      {
          $$ = $2;
      }

    ;

%%

int main()
{
    printf("Enter declarations and assignments:\n");

    yyparse();

    return 0;
}

int yyerror(char *s)
{
    printf("Invalid syntax\n");

    return 0;
}

