type.l
%{
#include "y.tab.h"
#include<string.h>
%}
%option noyywrap
%%
"int"       {return INT;}
"float"     {return FLOAT;}
[a-zA-Z]+   {strcpy(yylval.s,yytext);return ID;}
[0-9]+(\.[0-9]+)? {strcpy(yylval.s,yytext);return NUM;}
[ \t\n]+    ;
.           {return yytext[0];}
%%
type.y
%{
#include<stdio.h>
#include<string.h>
int yylex();
void yyerror(char *s){printf("Syntax Error\n");}
char name[20][20],type[20][10];
int n=0,i;
%}
%union {char s[20];}
%token INT FLOAT
%token <s> ID NUM
%%
S: S L | ;
L: INT ID ';' {
    strcpy(name[n],$2);strcpy(type[n++],"int");
    printf("Integer declared\n");
}
| FLOAT ID ';' {
    strcpy(name[n],$2);strcpy(type[n++],"float");
    printf("Float declared\n");
}
| ID '=' NUM ';' {
    for(i=0;i<n && strcmp(name[i],$1);i++);
    if(i==n) printf("Undeclared variable\n");
    else if(!strcmp(type[i],"int") && strchr($3,'.'))
        printf("Type mismatch\n");
    else printf("Type correct\n");
};
%%
int main(){printf("Enter declarations: ");yyparse();}
